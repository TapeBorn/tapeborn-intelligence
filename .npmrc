# TapeBorn NPM Configuration
# Enforce HTTPS registry only
registry=https://registry.npmjs.org/

# Prevent audit warnings in CI (optional)
audit=false

# Disable fund messages
fund=false

# Strict SSL
strict-ssl=true

# Prefer offline for faster installs (when lockfile is current)
prefer-offline=false

# Save exact versions
save-exact=true

# Engine strict
engine-strict=true